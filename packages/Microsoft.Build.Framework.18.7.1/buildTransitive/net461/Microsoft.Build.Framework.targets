<Project InitialTargets="NETStandardCompatError_Microsoft_Build_Framework_net472">
  <Target Name="NETStandardCompatError_Microsoft_Build_Framework_net472"
          Condition="'$(SuppressTfmSupportBuildWarnings)' == ''">
    <Warning Text="Microsoft.Build.Framework 18.7.1 doesn't support $(TargetFramework) and has not been tested with it. Consider upgrading your TargetFramework to net472 or later. You may also set &lt;SuppressTfmSupportBuildWarnings&gt;true&lt;/SuppressTfmSupportBuildWarnings&gt; in the project file to ignore this warning and attempt to run in this unsupported configuration at your own risk." />
  </Target>
</Project>
